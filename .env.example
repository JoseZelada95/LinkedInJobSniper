# Plantilla de variables de entorno — LinkedIn Job Sniper
# Copia este archivo a `.env` (local) o configbra los Secrets en GitHub Actions.

# ── LLM (Groq por defecto) ──────────────────────────────────────────
API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx
API_BASE=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
CRITERIA=

# ── DeepSeek (fallback de pago, opcional) ───────────────────────────
# Si Groq agota su cuota, se usa DeepSeek. Off-peak es la mitad de precio;
# peak: 01:00-04:00 y 06:00-10:00 UTC, L-V.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ── CV ──────────────────────────────────────────────────────────────
RESUME_TEXT=Pega aquí tu CV completo en texto plano

# ── Umbrales ────────────────────────────────────────────────────────
SCORE_THRESHOLD=50
TAILOR_THRESHOLD=75
TOP_JOBS_LIMIT=20
HOURS_OLD=48
RESULT_LIMIT=8

# ── Email ───────────────────────────────────────────────────────────
EMAIL_SENDER=tu_correo@gmail.com
EMAIL_PASSWORD=contrasena_de_aplicacion_gmail
EMAIL_RECEIVER=tu_correo@gmail.com

# ── Google (Sheets/Drive) ───────────────────────────────────────────
GOOGLE_SHEET_ID=
GCP_CREDENTIALS_JSON=
RESUME_FILE_ID=

# ── InfoJobs (API oficial) ──────────────────────────────────────────
# Registro de app en https://developer.infojobs.net (opcional: sin
# credenciales la fuente de InfoJobs se omite).
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=

# ── Otros ───────────────────────────────────────────────────────────
PROXY_URL=
